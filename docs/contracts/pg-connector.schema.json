{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Consent": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "view_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "source_id",
        "source_digest",
        "view_ids",
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "GrantReceipt": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "grant_id"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "view_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "source_id",
        "source_digest",
        "view_ids"
      ],
      "additionalProperties": false
    },
    "Grant": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "view_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "grant_id",
        "source_id",
        "source_digest",
        "view_ids",
        "expires_at",
        "revoked"
      ],
      "additionalProperties": false
    },
    "Inventory": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 32
        },
        "recent_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Grant"
          },
          "maxItems": 100
        },
        "run_readable": {
          "type": "boolean"
        }
      },
      "required": [
        "sources",
        "recent_grants",
        "run_readable"
      ],
      "additionalProperties": false
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "list_views"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "describe_view"
            },
            "view_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "action",
            "view_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "query_view"
            },
            "view_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            },
            "equals": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "column",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 20
                },
                {
                  "type": "null"
                }
              ]
            },
            "descending": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "action",
            "view_id",
            "columns",
            "limit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Output": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "external_untrusted_data"
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "view_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "view_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "view_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "columns": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "text",
                      "int8",
                      "bool"
                    ]
                  }
                },
                "paging_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "view_id",
                "columns",
                "paging_key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "maxItems": 1000
                },
                "next_after": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|-?[1-9][0-9]*)$",
                      "maxLength": 20
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "rows",
                "next_after"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
