{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.invalid/contracts/account.v1.schema.json",
  "$defs": {
    "CreateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "limit"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        }
      }
    },
    "BudgetView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_budget_id",
        "scope_id",
        "limit",
        "spent",
        "reserved",
        "status"
      ],
      "properties": {
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "spent": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "reserved": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "closing",
            "closed"
          ]
        }
      }
    },
    "WalletView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "owner_id",
        "gift",
        "earned",
        "purchased",
        "reserved_gift",
        "reserved_earned",
        "reserved_purchased",
        "pending_earned"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "gift": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "earned": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "purchased": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "reserved_gift": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "reserved_earned": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "reserved_purchased": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "pending_earned": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        }
      }
    },
    "PersonalBudgetList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "owner_id",
        "data",
        "next_cursor"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/BudgetView"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id",
        "retry_class"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retry_class": {
          "type": "string"
        }
      }
    },
    "SupportResourceVersion": {
      "type": "object",
      "required": [
        "artifact_id",
        "version_id"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "SupportConsentCreate": {
      "type": "object",
      "required": [
        "ticket_id",
        "purpose",
        "resources",
        "content_field",
        "duration_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/SupportResourceVersion"
          },
          "uniqueItems": true
        },
        "content_field": {
          "const": "file_content"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "SupportConsent": {
      "type": "object",
      "required": [
        "authorization_id",
        "subject_user_id",
        "owner_id",
        "ticket_id",
        "purpose",
        "resources",
        "content_field",
        "created_at",
        "expires_at",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "subject_user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/SupportResourceVersion"
          },
          "uniqueItems": true
        },
        "content_field": {
          "const": "file_content"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "active",
            "expired",
            "unavailable",
            "revoked"
          ]
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SupportConsentList": {
      "type": "object",
      "required": [
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SupportConsent"
          }
        },
        "next_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "SupportFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "artifact_id",
        "version_id",
        "sha256",
        "size_bytes"
      ]
    },
    "SupportFileList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SupportFile"
          }
        },
        "next_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "subject_user_id",
        "owner_id",
        "data"
      ]
    },
    "ProviderIncome": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "units": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical microcredits. Checked Rust money also rejects values above 9223372036854775807. Never a JS number."
        },
        "eligible_unix": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "state": {
          "enum": [
            "pending",
            "review",
            "available"
          ]
        }
      },
      "required": [
        "job_id",
        "units",
        "eligible_unix",
        "state"
      ],
      "additionalProperties": false
    },
    "ProviderIncomeList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "owner_id",
        "data",
        "next_cursor"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ProviderIncome"
          }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
