{
  "openapi": "3.1.0",
  "info": {
    "title": "Orange CN-06 hosted Run S3 connector",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/agent/runs/{run}/connectors/s3": {
      "get": {
        "operationId": "listS3Sources",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "User session required"
          },
          "403": {
            "description": "Consent, origin or active Run required"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Consumed request, changed source or conflicting intent"
          },
          "413": {
            "description": "Result limit"
          },
          "429": {
            "description": "Run limit"
          },
          "503": {
            "description": "Source or identity service unavailable"
          }
        }
      },
      "post": {
        "operationId": "grantS3Prefix",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "User session required"
          },
          "403": {
            "description": "Consent, origin or active Run required"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Consumed request, changed source or conflicting intent"
          },
          "413": {
            "description": "Result limit"
          },
          "429": {
            "description": "Run limit"
          },
          "503": {
            "description": "Source or identity service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Consent"
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/runs/{run}/connectors/s3/{grant}": {
      "delete": {
        "operationId": "revokeS3Grant",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "grant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "User session required"
          },
          "403": {
            "description": "Consent, origin or active Run required"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Consumed request, changed source or conflicting intent"
          },
          "413": {
            "description": "Result limit"
          },
          "429": {
            "description": "Run limit"
          },
          "503": {
            "description": "Source or identity service unavailable"
          }
        }
      }
    },
    "/api/v1/agent/runs/{run}/connectors/s3/{grant}/actions": {
      "post": {
        "operationId": "readS3Objects",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "grant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Output"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "User session required"
          },
          "403": {
            "description": "Consent, origin or active Run required"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Consumed request, changed source or conflicting intent"
          },
          "413": {
            "description": "Result limit"
          },
          "429": {
            "description": "Run limit"
          },
          "503": {
            "description": "Source or identity service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/runs/{run}/connectors/s3/{grant}/artifacts/{artifact}/content": {
      "post": {
        "operationId": "downloadS3Artifact",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "grant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "artifact",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "in": "path"
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Digest-verified object bytes after rechecking live grant and source version",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "User session required"
          },
          "403": {
            "description": "Consent, origin or active Run required"
          },
          "404": {
            "description": "Unknown resource"
          },
          "409": {
            "description": "Consumed request, changed source or conflicting intent"
          },
          "413": {
            "description": "Result limit"
          },
          "429": {
            "description": "Run limit"
          },
          "503": {
            "description": "Source or identity service unavailable"
          }
        }
      }
    }
  },
  "security": [
    {
      "UserSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bucket": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "bucket",
          "prefix"
        ],
        "additionalProperties": false
      },
      "Grant": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "grant_id",
          "expires_at",
          "revoked"
        ],
        "additionalProperties": false
      },
      "Consent": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "duration_seconds"
        ],
        "additionalProperties": false
      },
      "GrantReceipt": {
        "type": "object",
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "grant_id"
        ],
        "additionalProperties": false
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "maxItems": 32
          },
          "recent_grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            },
            "maxItems": 100
          },
          "run_readable": {
            "type": "boolean"
          }
        },
        "required": [
          "sources",
          "recent_grants",
          "run_readable"
        ],
        "additionalProperties": false
      },
      "Head": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "key",
          "etag",
          "version",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "List": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 100
          },
          "next_after": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "keys",
          "next_after"
        ],
        "additionalProperties": false
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "source_backed_artifact"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "head": {
            "$ref": "#/components/schemas/Head"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "artifact_id",
          "head",
          "sha256"
        ],
        "additionalProperties": false
      },
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "list_objects"
              },
              "after": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "action",
              "limit"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "head_object"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "action",
              "key"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "read_object"
              },
              "expected": {
                "$ref": "#/components/schemas/Head"
              }
            },
            "required": [
              "action",
              "expected"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Output": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "external_untrusted_data"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Head"
              },
              {
                "$ref": "#/components/schemas/List"
              },
              {
                "$ref": "#/components/schemas/Artifact"
              }
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
}
