{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:pricing:v1",
  "$defs": {
    "CreateTextQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "root_budget_id",
        "price_version",
        "input_upload_id",
        "input_version_id",
        "output_limit"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_upload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "output_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "TextQuoteView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "root_budget_id",
        "invocation_id",
        "price_version",
        "request_projection_digest",
        "meter_profile_digest",
        "input_units",
        "output_limit",
        "max_amount",
        "expires_at_unix"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "request_projection_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "meter_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_units": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "output_limit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "max_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical decimal microcredits, maximum9223372036854775807 enforced by the checked money type."
        },
        "expires_at_unix": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "TextPriceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_version",
        "model_version",
        "node_id",
        "meter_profile_digest",
        "input_price",
        "output_price",
        "output_limit",
        "fee_bps"
      ],
      "properties": {
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "meter_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical decimal microcredits, maximum9223372036854775807 enforced by the checked money type."
        },
        "output_price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical decimal microcredits, maximum9223372036854775807 enforced by the checked money type."
        },
        "output_limit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "fee_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id",
        "retry_class"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retry_class": {
          "type": "string"
        }
      }
    },
    "QuoteFundingView": {
      "type": "object",
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "requester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "max_microcredits": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "budget_limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "budget_spent": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "budget_reserved": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "budget_remaining": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "observed_unix": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "expires_unix": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "account_kind": {
          "enum": [
            "personal",
            "team"
          ]
        },
        "wallet_available": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "sufficient",
            "expired",
            "budget_closed",
            "spending_paused",
            "insufficient_budget",
            "insufficient_funds"
          ]
        }
      },
      "required": [
        "quote_id",
        "requester_id",
        "owner_id",
        "root_budget_id",
        "price_version",
        "max_microcredits",
        "budget_limit",
        "budget_spent",
        "budget_reserved",
        "budget_remaining",
        "observed_unix",
        "expires_unix",
        "account_kind",
        "wallet_available",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
