{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.invalid/contracts/cloud-agent.v1.schema.json",
  "$defs": {
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id",
        "retry_class"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retry_class": {
          "type": "string"
        }
      }
    },
    "CloudRunCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "resource_profile_id": {
          "const": "dev-gvisor-linux-arm64-v1"
        },
        "workspace_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "model": {
          "$ref": "#/$defs/ModelSelection"
        },
        "allow_external_connectors": {
          "type": "boolean",
          "default": false
        },
        "allow_document_connectors": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "root_budget_id",
        "input_artifact_id",
        "input_version_id",
        "resource_profile_id",
        "workspace_ttl_seconds"
      ]
    },
    "CloudWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "status": {
          "enum": [
            "requested",
            "preparing",
            "ready",
            "running",
            "draining",
            "deleted",
            "quarantined"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "resource_profile_id": {
          "const": "dev-gvisor-linux-arm64-v1"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspace_id",
        "status",
        "version",
        "resource_profile_id",
        "expires_at"
      ]
    },
    "CloudRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelled",
            "recovery_required",
            "failed",
            "completed",
            "waiting_approval",
            "paused"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace": {
          "$ref": "#/$defs/CloudWorkspace"
        }
      },
      "required": [
        "run_id",
        "owner_id",
        "user_id",
        "status",
        "version",
        "root_budget_id",
        "input_artifact_id",
        "input_version_id",
        "created_at",
        "workspace"
      ]
    },
    "CloudRunList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CloudRun"
          }
        },
        "next_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "user_id",
        "owner_id",
        "data"
      ]
    },
    "CloudCapacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "resource_profile_id": {
          "const": "dev-gvisor-linux-arm64-v1"
        },
        "max_active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "occupied": {
          "type": "integer",
          "minimum": 0
        },
        "can_reserve": {
          "type": "boolean"
        },
        "pool_available": {
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "owner_id",
        "resource_profile_id",
        "max_active",
        "occupied",
        "can_reserve",
        "pool_available"
      ]
    },
    "CloudRunWithdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "user_id",
        "request_key",
        "receipt_id"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "run": {
          "$ref": "#/$defs/CloudRun"
        }
      }
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "output_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "tool": {
          "$ref": "#/$defs/CloudToolChoice"
        },
        "continue_after_tool": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "price_version",
        "model_version",
        "invocation_id",
        "output_limit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "continue_after_tool": {
                "const": true
              }
            },
            "required": [
              "continue_after_tool"
            ]
          },
          "then": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "properties": {
                  "name": {
                    "const": "list_directory"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CloudModelStatus": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "input_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "output_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "stage": {
          "enum": [
            "awaiting_workspace",
            "ready_to_quote",
            "submitted",
            "result_available",
            "stopped",
            "unavailable",
            "waiting_tool",
            "tool_result_available",
            "continuation_ready"
          ]
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "request_projection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool": {
          "$ref": "#/$defs/CloudToolChoice"
        },
        "turn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "source_input_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "model_input_upload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "run_id",
        "owner_id",
        "user_id",
        "root_budget_id",
        "input_version_id",
        "price_version",
        "model_version",
        "invocation_id",
        "output_limit",
        "stage"
      ],
      "additionalProperties": false
    },
    "ConfirmCloudModel": {
      "type": "object",
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "request_projection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "max_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical integer microcredits."
        }
      },
      "required": [
        "quote_id",
        "request_projection_digest",
        "max_amount"
      ],
      "additionalProperties": false
    },
    "TextQuoteView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "root_budget_id",
        "invocation_id",
        "price_version",
        "request_projection_digest",
        "meter_profile_digest",
        "input_units",
        "output_limit",
        "max_amount",
        "expires_at_unix"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "price_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "request_projection_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "meter_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_units": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "output_limit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "max_amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Canonical decimal microcredits, maximum9223372036854775807 enforced by the checked money type."
        },
        "expires_at_unix": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "JobView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "root_budget_id",
        "invocation_id",
        "execution_state",
        "settlement_state",
        "reserved",
        "charge"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "execution_state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "settlement_state": {
          "type": "string",
          "enum": [
            "pending",
            "settled",
            "reversed"
          ]
        },
        "reserved": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Checked signed64-bit nonnegative credit units."
        },
        "charge": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$",
              "description": "Checked signed64-bit nonnegative credit units."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ModelResponseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Committed model output payload, maximum1048576 UTF-8 JSON bytes. Tool calls remain untrusted and require host validation/approval; native_usage is not a billing fact.",
      "required": [
        "response_id",
        "text",
        "tool_calls",
        "native_usage",
        "finish_reason"
      ],
      "properties": {
        "response_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 80,
          "description": "IDs must be unique; names must belong to the original GenerateRequest tool set.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "arguments"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        },
        "native_usage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "output_tokens"
              ],
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          ]
        },
        "finish_reason": {
          "enum": [
            "stop",
            "tool_calls"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "finish_reason": {
                "const": "stop"
              }
            }
          },
          "then": {
            "properties": {
              "tool_calls": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "tool_calls": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "CloudModelResult": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "response": {
          "$ref": "#/$defs/ModelResponseCandidate"
        }
      },
      "required": [
        "run_id",
        "user_id",
        "owner_id",
        "job_id",
        "response"
      ],
      "additionalProperties": false
    },
    "CloudToolChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "execution_digest"
      ],
      "properties": {
        "name": {
          "enum": [
            "list_directory",
            "list_views",
            "describe_view",
            "query_view",
            "list_objects",
            "head_object",
            "read_object",
            "list_repositories",
            "list_projects"
          ]
        },
        "execution_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CloudTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "execution_digest",
        "tool_version",
        "policy_version",
        "approval_required",
        "execution_environment",
        "model_definition"
      ],
      "properties": {
        "name": {
          "const": "list_directory"
        },
        "execution_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_required": {
          "const": true
        },
        "execution_environment": {
          "const": "hosted_workspace"
        },
        "model_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "parameters"
          ],
          "properties": {
            "name": {
              "const": "list_directory"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "parameters": {
              "type": "object"
            }
          }
        }
      }
    },
    "CloudTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "owner_id",
        "tools"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "tools": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/CloudTool"
          }
        }
      }
    },
    "CloudDirectoryArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "const": "."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "CloudDirectoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "snapshot_digest",
        "entries",
        "next_cursor",
        "omitted_unsupported"
      ],
      "properties": {
        "path": {
          "const": "."
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "bytes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128
              },
              "kind": {
                "const": "file"
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            }
          }
        },
        "next_cursor": {
          "type": "null"
        },
        "omitted_unsupported": {
          "type": "boolean"
        }
      }
    },
