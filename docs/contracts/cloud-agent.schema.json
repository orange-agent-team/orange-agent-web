            },
            "max_microcredits": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "charge_microcredits": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "execution_state": {
              "type": "string"
            },
            "settlement_state": {
              "type": "string"
            }
          },
          "required": [
            "job_id",
            "quote_id",
            "max_microcredits",
            "charge_microcredits",
            "execution_state",
            "settlement_state"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "settlement_state": {
                    "const": "settled"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge_microcredits": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "turn_id",
        "ordinal",
        "invocation_id",
        "input_version_id"
      ]
