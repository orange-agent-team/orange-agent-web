          },
          "amount_minor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,7}$"
          },
          "microcredits": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        },
        "required": [
