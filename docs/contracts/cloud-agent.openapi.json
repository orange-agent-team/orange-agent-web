  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "retry_class"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "retry_class": {
            "type": "string"
          }
        }
      },
      "CloudRunCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root_budget_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "input_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "input_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "resource_profile_id": {
            "const": "dev-gvisor-linux-arm64-v1"
          },
          "workspace_ttl_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          },
          "model": {
            "$ref": "#/components/schemas/ModelSelection"
          }
        },
        "required": [
          "root_budget_id",
          "input_artifact_id",
          "input_version_id",
          "resource_profile_id",
          "workspace_ttl_seconds"
        ]
      },
      "CloudWorkspace": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "status": {
            "enum": [
              "requested",
              "preparing",
              "ready",
              "running",
              "draining",
              "deleted",
              "quarantined"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "resource_profile_id": {
            "const": "dev-gvisor-linux-arm64-v1"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "workspace_id",
          "status",
          "version",
          "resource_profile_id",
          "expires_at"
        ]
      },
      "CloudRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "cancelled",
              "recovery_required",
              "failed",
              "completed",
              "waiting_approval",
              "paused"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "root_budget_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "input_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "input_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "workspace": {
            "$ref": "#/components/schemas/CloudWorkspace"
          }
        },
        "required": [
          "run_id",
          "owner_id",
          "user_id",
          "status",
          "version",
          "root_budget_id",
          "input_artifact_id",
          "input_version_id",
          "created_at",
          "workspace"
        ]
      },
      "CloudRunList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CloudRun"
            }
          },
          "next_before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "user_id",
          "owner_id",
          "data"
        ]
      },
      "CloudCapacity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "resource_profile_id": {
            "const": "dev-gvisor-linux-arm64-v1"
          },
          "max_active": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "occupied": {
            "type": "integer",
            "minimum": 0
          },
          "can_reserve": {
            "type": "boolean"
          },
          "pool_available": {
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "owner_id",
          "resource_profile_id",
          "max_active",
          "occupied",
          "can_reserve",
          "pool_available"
        ]
      },
      "CloudRunWithdrawal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "user_id",
          "request_key",
          "receipt_id"
        ],
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "request_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "run": {
            "$ref": "#/components/schemas/CloudRun"
          }
        }
      },
      "ModelSelection": {
        "type": "object",
        "properties": {
          "price_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "invocation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "output_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "price_version",
          "model_version",
          "invocation_id",
          "output_limit"
        ],
        "additionalProperties": false
      },
      "CloudModelStatus": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "root_budget_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "input_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
