      "get": {
        "operationId": "personalCloudWorkspaceCapacity",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current persisted projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudCapacity"
                }
              }
            }
          },
          "default": {
            "description": "Typed authorization, validation, capacity or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
