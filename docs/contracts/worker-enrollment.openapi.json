{
  "openapi": "3.1.0",
  "info": {
    "title": "Worker enrollment authorization",
    "version": "0.2.1",
    "description": "Manager authorizes a public Worker key. The dedicated development issuer prepares a short client certificate. The original independent token redeems one node identity."
  },
  "security": [
    {
      "userSession": []
    }
  ],
  "paths": {
    "/api/v1/owners/{owner}/worker-enrollments/{request}": {
      "parameters": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "request",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read enrollment authorization",
        "operationId": "getWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Authorize the exact verified device request",
        "operationId": "authorizeWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request or token commitment conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Hourly owner limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "exchange_token_sha256"
                ],
                "properties": {
                  "request": {
                    "$ref": "../json-schema/worker-certificate-request.v1.json"
                  },
                  "exchange_token_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke this authorization",
        "operationId": "revokeWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/worker-enrollments/{request}/redeem": {
      "post": {
        "operationId": "redeemPublicWorkerCertificate",
        "summary": "Activate the prepared client certificate once under current owner authority",
        "security": [
          {
            "enrollmentSecret": []
          }
        ],
        "parameters": [
          {
            "name": "request",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version",
                  "redemption_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "redemption_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original public client certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect, revoked, expired or mixed authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Certificate unavailable or previously redeemed with another key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      },
      "enrollmentSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Orange-Enrollment followed by a space and a canonical unpadded base64url 32-byte secret. No Cookie or Origin header."
      }
    },
    "schemas": {
      "EnrollmentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "owner_id",
          "requested_by",
          "spki_sha256",
          "csr_sha256",
          "state",
          "expires_unix"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          },
          "spki_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "csr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "authorized",
              "certificate_prepared",
              "redeemed",
              "expired",
              "revoked"
            ]
          },
          "expires_unix": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "CertificateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "request_id",
          "redemption_id",
          "node_id",
          "spki_sha256",
          "certificate_sha256",
          "issuer_sha256",
          "expires_unix",
          "certificate_pem"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "redemption_id": {
            "type": "string",
            "format": "uuid"
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "spki_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "certificate_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "issuer_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_unix": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "certificate_pem": {
            "type": "string",
            "maxLength": 16384
          }
        }
      }
    }
  }
}
