{
  "openapi": "3.1.0",
  "info": {
    "title": "Worker enrollment authorization",
    "version": "0.3.0",
    "description": "Owner-managed enrollment and device-key rotation. Replacement authorization binds a fresh CSR and token commitment to a currently active device, its old key and the same owner and node."
  },
  "security": [
    {
      "userSession": []
    }
  ],
  "paths": {
    "/api/v1/owners/{owner}/worker-enrollments/{request}": {
      "parameters": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "request",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read enrollment authorization",
        "operationId": "getWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Authorize the exact verified device request",
        "operationId": "authorizeWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request or token commitment conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Hourly owner limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "exchange_token_sha256"
                ],
                "properties": {
                  "request": {
                    "$ref": "../json-schema/worker-certificate-request.v1.json"
                  },
                  "exchange_token_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke this authorization",
        "operationId": "revokeWorkerEnrollment",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/worker-enrollments/{request}/redeem": {
      "post": {
        "operationId": "redeemPublicWorkerCertificate",
        "summary": "Activate the prepared client certificate once under current owner authority",
        "security": [
          {
            "enrollmentSecret": []
          }
        ],
        "parameters": [
          {
            "name": "request",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version",
                  "redemption_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "redemption_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original public client certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect, revoked, expired or mixed authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Certificate unavailable or previously redeemed with another key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/owners/{owner}/worker-certificate-rotations/{request}": {
      "parameters": [
        {
          "name": "owner",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "request",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Authorize one old-key-signed replacement of the current Worker certificate",
        "operationId": "authorizeWorkerCertificateRotation",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request or token commitment conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Hourly owner limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentView"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RotationHandoff"
              }
            }
          }
        },
        "description": "Independent manager permission, CSRF, origin and request idempotency key are required. Preparing the replacement does not activate it. Only one successor can redeem a predecessor. The original node is preserved. The old leaf expires at the earlier of its current deadline and two minutes after activation. A successful Hello with the successor fences the old leaf immediately. Use the original enrollment status and withdrawal routes for the new request ID."
      },
      "get": {
        "summary": "Read the stored rotation identity and authoritative activation receipt",
        "operationId": "getWorkerCertificateRotation",
        "responses": {
          "422": {
            "description": "Invalid request, CSR or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session unavailable or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner permission, origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown owner-scoped request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/user.schema.json#/$defs/Error"
                }
              }
            }
          },
          "200": {
            "description": "Current enrollment authorization metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotationView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      },
      "enrollmentSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Orange-Enrollment followed by a space and a canonical unpadded base64url 32-byte secret. No Cookie or Origin header."
      }
    },
    "schemas": {
      "EnrollmentView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "owner_id",
          "requested_by",
          "spki_sha256",
          "csr_sha256",
          "state",
          "expires_unix"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          },
          "spki_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "csr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "authorized",
              "certificate_prepared",
              "redeemed",
              "expired",
              "revoked"
            ]
          },
          "expires_unix": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "CertificateReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "request_id",
          "redemption_id",
          "node_id",
          "spki_sha256",
          "certificate_sha256",
          "issuer_sha256",
          "expires_unix",
          "certificate_pem"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "redemption_id": {
            "type": "string",
            "format": "uuid"
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "spki_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "certificate_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "issuer_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_unix": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "certificate_pem": {
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "RotationHandoff": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "previous_key_signature"
        ],
        "properties": {
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "owner_id",
              "node_id",
              "previous_request_id",
              "previous_certificate_sha256",
              "previous_issuer_sha256",
              "replacement"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "const": 1
              },
              "owner_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "node_id": {
                "type": "string",
                "format": "uuid"
              },
              "previous_request_id": {
                "type": "string",
                "format": "uuid"
              },
              "previous_certificate_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "previous_issuer_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "replacement": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "exchange_token_sha256"
                ],
                "properties": {
                  "request": {
                    "$ref": "../json-schema/worker-certificate-request.v1.json"
                  },
                  "exchange_token_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "previous_key_signature": {
            "type": "string",
            "minLength": 86,
            "maxLength": 86,
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "description": "Unpadded base64url signature by the installed Ed25519 key over the lowercase ASCII request digest for worker-certificate-rotation.v1."
          }
        }
      },
      "RotationView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollment",
          "node_id",
          "previous_request_id",
          "previous_certificate_sha256",
          "intent_sha256",
          "predecessor_eligible",
          "activated_unix",
          "overlap_until_unix"
        ],
        "properties": {
          "enrollment": {
            "$ref": "#/components/schemas/EnrollmentView"
          },
          "node_id": {
            "type": "string",
            "format": "uuid"
          },
          "previous_request_id": {
            "type": "string",
            "format": "uuid"
          },
          "previous_certificate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "intent_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "predecessor_eligible": {
            "type": "boolean"
          },
          "activated_unix": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,12})$"
          },
          "overlap_until_unix": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]{0,12})$"
          }
        }
      }
    }
  }
}
