                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rows",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Output": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "external_untrusted_data"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SearchResults"
              },
              {
                "$ref": "#/components/schemas/Page"
              },
              {
                "$ref": "#/components/schemas/Blocks"
              },
              {
                "$ref": "#/components/schemas/Rows"
              }
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
