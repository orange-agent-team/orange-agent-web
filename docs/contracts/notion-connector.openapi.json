                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "action",
              "root"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "list_blocks"
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "target": {
