      "Block": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "type": {
            "type": "string"
          },
          "last_edited_time": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1024
          },
          "expression": {
            "type": "string"
          },
          "projected": {
            "const": false
          },
          "children": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6144
          }
        },
        "required": [
          "block_id",
          "type",
          "last_edited_time"
        ],
        "additionalProperties": false
      },
      "SearchResults": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "page": {
                  "$ref": "#/components/schemas/Summary"
                }
              },
              "required": [
                "root",
                "page"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 6144
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "pages",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Blocks": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 6144
