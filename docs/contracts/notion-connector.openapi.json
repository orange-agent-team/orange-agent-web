                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6144
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6144
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "action",
              "root",
              "limit"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "query_database"
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "data_source": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6144
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "filter": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Filter"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sort": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Sort"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "action",
              "root",
              "data_source",
              "limit"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Summary": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string"
          },
          "last_edited_time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "page_id",
          "title",
          "last_edited_time"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string"
          },
          "last_edited_time": {
            "type": "string",
            "format": "date-time"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "type",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "projected": {
