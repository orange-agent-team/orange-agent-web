                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "title",
                  "rich_text",
                  "status",
                  "select"
                ]
              },
              "equals": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": [
              "property",
              "kind",
              "equals"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "number"
                ]
              },
              "equals": {
                "type": "number"
              }
            },
            "required": [
              "property",
              "kind",
              "equals"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "checkbox"
                ]
              },
              "equals": {
                "type": "boolean"
              }
            },
            "required": [
              "property",
              "kind",
              "equals"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Sort": {
        "type": "object",
        "properties": {
          "timestamp": {
            "enum": [
              "created_time",
              "last_edited_time"
            ]
          },
          "direction": {
            "enum": [
              "ascending",
              "descending"
            ]
          }
        },
        "required": [
          "timestamp",
          "direction"
        ],
        "additionalProperties": false
      },
      "Action": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "search_pages"
              },
              "query": {
                "type": "string",
                "maxLength": 1024
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6144
