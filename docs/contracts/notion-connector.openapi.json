  "security": [
    {
      "UserSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "roots": {
            "type": "object",
            "maxProperties": 100,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "page"
                    },
                    "page_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                    }
                  },
                  "required": [
                    "kind",
                    "page_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "database"
                    },
                    "database_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                    },
                    "data_sources": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                      },
                      "maxItems": 32,
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "kind",
                    "database_id",
                    "data_sources"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "roots"
        ],
        "additionalProperties": false
      },
      "Grant": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "root_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "grant_id",
          "root_keys",
          "expires_at",
          "revoked"
        ],
        "additionalProperties": false
      },
      "Consent": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "root_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "source_id",
          "source_digest",
          "root_keys",
          "duration_seconds"
        ],
        "additionalProperties": false
      },
      "GrantReceipt": {
        "type": "object",
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "grant_id"
        ],
        "additionalProperties": false
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "maxItems": 32
          },
          "recent_grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            },
            "maxItems": 100
          },
          "run_readable": {
            "type": "boolean"
          },
          "document_access_selected": {
            "type": "boolean"
          }
        },
        "required": [
          "sources",
          "recent_grants",
          "run_readable",
          "document_access_selected"
        ],
        "additionalProperties": false
      },
