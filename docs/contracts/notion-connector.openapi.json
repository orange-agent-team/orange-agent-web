          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Consent"
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/runs/{run}/connectors/notion/{grant}": {
      "delete": {
        "operationId": "revokeNotionGrant",
        "parameters": [
          {
            "name": "run",
