{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/team-governance.v1.json",
  "$defs": {
    "TeamMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "member",
            "billing",
            "viewer"
          ]
        }
      },
      "required": [
        "user_id",
        "role"
      ]
    },
    "TeamMembers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/TeamMember"
          }
        }
      },
      "required": [
        "organization_id",
        "policy_version",
        "data"
      ]
    },
    "MembershipChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "admin",
                "member",
                "billing",
                "viewer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_policy_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "user_id",
        "role",
        "expected_policy_version"
      ]
    },
    "MembershipReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "admin",
                "member",
                "billing",
                "viewer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "organization_id",
        "user_id",
        "role",
        "policy_version"
      ]
    },
    "IssueInvitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "member",
            "billing",
            "viewer"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "expected_policy_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "invitation_id",
        "recipient_id",
        "role",
        "ttl_seconds",
        "expected_policy_version"
      ]
    },
    "Invitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "member",
            "billing",
            "viewer"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "accepted",
            "revoked",
            "declined",
            "expired"
          ]
        },
        "expires_at_unix": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "accepted_policy_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "invitation_id",
        "organization_id",
        "organization_name",
        "issuer_id",
        "recipient_id",
        "role",
        "state",
        "expires_at_unix",
        "accepted_policy_version"
      ]
    },
    "Invitations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Invitation"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "user_id",
        "data",
        "next_cursor"
      ]
    },
    "ExplicitAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accept": {
          "const": true
        }
      },
      "required": [
        "accept"
      ]
    },
    "Empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "BudgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "owner_ceiling": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hard_limit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocated": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "required": [
        "organization_id",
        "owner_ceiling",
        "hard_limit",
        "allocated",
        "version"
      ]
    },
    "SetBudgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "hard_limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "owner_ceiling": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expected_version",
        "hard_limit"
      ]
    },
    "CreateAllocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "member_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "expected_policy_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "required": [
        "budget_id",
        "member_id",
        "limit",
        "expected_policy_version"
      ]
    },
    "AdjustAllocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "allow_submit": {
          "type": "boolean"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "limit",
        "allow_submit",
        "expected_version"
      ]
    },
    "MemberBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_budget_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "spent": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "reserved": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "state": {
          "enum": [
            "active",
            "closing",
            "closed"
          ]
        },
        "allow_submit": {
          "type": "boolean"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "root_budget_id",
        "organization_id",
        "member_id",
        "limit",
        "spent",
        "reserved",
        "state",
        "allow_submit",
        "version"
      ]
    },
    "MemberBudgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/MemberBudget"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "data",
        "next_cursor"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "CSRF_INVALID",
            "AUTH_CONTEXT_REQUIRED",
            "VALIDATION_ERROR",
            "SERVICE_UNAVAILABLE",
            "NOT_FOUND",
            "IDEMPOTENCY_CONFLICT",
            "VERSION_CONFLICT",
            "CAPACITY_EXCEEDED",
            "LAST_OWNER_REQUIRED",
            "TEAM_BUDGET_EXCEEDED",
            "TEAM_BUDGET_NOT_CONFIGURED",
            "BUDGET_ALREADY_COMMITTED"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "retry_class": {
          "type": "string",
          "enum": [
            "never",
            "after_reauth",
            "query_original"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retry_class"
      ],
      "additionalProperties": false
    },
    "ResourceSharingChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "access": {
          "anyOf": [
            {
              "enum": [
                "read",
                "write"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_acl_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "user_id",
        "access",
        "expected_acl_version"
      ]
    },
    "ResourceSharingReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "creator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "acl_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "access": {
          "anyOf": [
            {
              "enum": [
                "read",
                "write"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "resource_id",
        "creator_id",
        "acl_version",
        "user_id",
        "access"
      ]
    },
    "ResourceSharingList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "creator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "acl_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "access": {
                "enum": [
                  "read",
                  "write"
                ]
              }
            },
            "required": [
              "user_id",
              "access"
            ]
          }
        }
      },
      "required": [
        "organization_id",
        "resource_id",
        "creator_id",
        "acl_version",
        "data"
      ]
    }
  }
}
