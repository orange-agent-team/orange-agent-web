  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "CreateUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upload_id",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "upload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7}|10[0-3][0-9]{6}|104[0-7][0-9]{5}|1048[0-4][0-9]{4}|10485[0-6][0-9]{3}|104857[0-5][0-9]{2}|104857600)$",
            "description": "Canonical decimal byte length; maximum104857600. Declared media maximum100000000."
          },
          "media_type": {
            "type": "string",
            "enum": [
              "application/octet-stream",
              "application/json",
              "text/plain",
              "image/png",
              "image/jpeg",
              "image/webp",
              "audio/wav",
              "audio/mpeg",
              "audio/flac",
              "audio/ogg",
              "video/mp4"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp",
                    "audio/wav",
                    "audio/mpeg",
                    "audio/flac",
                    "audio/ogg",
                    "video/mp4"
                  ]
                }
              },
              "required": [
                "media_type"
              ]
            },
            "then": {
              "properties": {
                "size_bytes": {
                  "pattern": "^(0|[1-9][0-9]{0,7}|100000000)$"
                }
              }
            }
          }
        ]
      },
      "ArtifactView": {
        "type": "object",
