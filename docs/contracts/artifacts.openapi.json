            "description": "Canonical decimal byte length; maximum104857600. Declared media maximum100000000."
          },
          "media_type": {
            "type": "string",
            "enum": [
              "application/octet-stream",
              "application/json",
              "text/plain",
              "image/png",
              "image/jpeg",
              "image/webp",
              "audio/wav",
              "audio/mpeg",
              "audio/flac",
              "audio/ogg",
              "video/mp4",
              "application/vnd.orange.model-response+json"
            ]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "state": {
            "type": "string",
            "enum": [
              "staging",
              "available",
              "deleted"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp",
                    "audio/wav",
                    "audio/mpeg",
                    "audio/flac",
                    "audio/ogg",
                    "video/mp4"
                  ]
                }
              },
              "required": [
                "media_type"
              ]
            },
            "then": {
              "properties": {
                "size_bytes": {
                  "pattern": "^(0|[1-9][0-9]{0,7}|100000000)$"
                }
              }
            }
          }
        ]
      },
