{
  "openapi": "3.1.0",
  "info": {
    "title": "Orange private artifact API",
    "version": "0.1.4",
    "description": "Current user sessions and independent artifact/source content ACLs. Includes committed Worker response references. Model execution success does not imply settlement or resource cleanup. Native usage is never a billing grant."
  },
