    "/api/v1/owners/{owner}/jobs/{job}/cancel": {
      "post": {
        "operationId": "requestOriginatingUserJobCancellation",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
